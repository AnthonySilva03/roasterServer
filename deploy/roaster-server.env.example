SECRET_KEY=change-me
DATABASE_URL=sqlite:////home/pi/roasterServer/instance/roasts.db
SENSOR_MODE=simulated
START_SENSOR_BACKGROUND_TASK=true
LOG_LEVEL=INFO

# Serve on port 80 so the phone can open http://10.42.0.1 with no port suffix.
# The systemd unit grants CAP_NET_BIND_SERVICE so this binds while running as pi.
PORT=80
# Auto-open the app when a phone joins the Roaster network (direct-ap mode).
CAPTIVE_PORTAL_ENABLED=true

# Network operating mode for scripts/wifi_provisioning_bootstrap.sh:
#   direct-ap  Pi runs its own Wi-Fi hub and serves the full app to a directly
#              connected phone (no shared router needed). Default.
#   provision  Try saved Wi-Fi, fall back to a setup hotspot for onboarding.
#   client     Use saved Wi-Fi only; never start a hotspot.
ROASTER_NET_MODE=direct-ap

WIFI_INTERFACE=wlan0
# In direct-ap mode these define the Pi's own permanent network. CHANGE THE PASSWORD.
WIFI_SETUP_SSID=Roaster
WIFI_SETUP_PASSWORD=roastme123
WIFI_SETUP_CONNECTION_NAME=roaster-ap
WIFI_CONNECT_WAIT_SECONDS=20
WIFI_USE_SUDO_FOR_NMCLI=true
