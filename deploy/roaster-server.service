[Unit]
Description=Roaster Server app (pigpio hardware, port 80)
# Networking for the direct-AP is handled by separate hostapd + dnsmasq
# services (see scripts/install_pi_ap.sh); this unit just runs the app.
After=hostapd.service pigpiod.service
Wants=pigpiod.service

[Service]
User=pi
Group=pi
WorkingDirectory=/home/pi/roasterServer
EnvironmentFile=/home/pi/roasterServer/deploy/roaster-server.env
ExecStart=/home/pi/roasterServer/venv/bin/python run.py
# Allow binding the privileged port 80 (PORT=80 in the env) while running as pi.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
